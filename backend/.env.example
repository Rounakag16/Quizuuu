PORT=4000
# Local MongoDB, or a MongoDB Atlas connection string when you deploy
MONGODB_URI=mongodb://localhost:27017/mcq-practice-app
# Any long random string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Leave blank in local dev (allows any origin). In production, set this to
# your deployed frontend's exact URL, e.g. https://your-app.vercel.app
CORS_ORIGIN=
